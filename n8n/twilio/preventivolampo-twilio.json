      "parameters": {
        "jsCode": "// WhatsApp manda i vocali in OGG/Opus: il servizio di trascrizione vuole l'estensione nel nome del file.\nconst it = $input.first();\nconst mime = $('Verifica e smista').first().json.mime || 'audio/ogg';\nconst est = mime.includes('ogg') ? 'ogg' : mime.includes('mpeg') ? 'mp3' : mime.includes('mp4') || mime.includes('aac') ? 'm4a' : mime.includes('amr') ? 'amr' : 'ogg';\nit.binary.data.fileName = 'vocale.' + est;\nit.binary.data.mimeType = mime.split(';')[0];\nit.binary.data.fileExtension = est;\nreturn [it];"
      }
    },
