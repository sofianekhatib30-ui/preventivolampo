      "parameters": {
        "jsCode": "// ⚙️ IMPOSTAZIONI (si compilano una volta, solo in n8n)\n// Auth Token di Twilio: console.twilio.com → Account Info → Auth Token (lo stesso della credenziale «Twilio · account»).\nconst AUTH_TOKEN = '';\n// L'indirizzo esatto che hai incollato in Twilio (Sandbox settings → «When a message comes in»): serve per la firma.\nconst INDIRIZZO = 'https://kdigitalsolution.app.n8n.cloud/webhook/preventivolampo-twilio';\n// Vocali: true dopo aver messo la credenziale del servizio di trascrizione nel nodo «Trascrivi il vocale».\nconst VOCALI_ATTIVI = false;\nconst TWILIO = 'https://api.twilio.com';\nconst TRASCRIZIONE_URL = 'https://api.openai.com/v1/audio/transcriptions';\nconst TRASCRIZIONE_MODELLO = 'whisper-1';\n\n// Twilio firma ogni richiesta: HMAC-SHA1 con l'Auth Token su indirizzo + parametri in ordine alfabetico.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst p = item.json.body || {};\nconst out = (o) => [{ json: { TWILIO, TRASCRIZIONE_URL, TRASCRIZIONE_MODELLO, ...o } }];\n\nfunction firmaValida() {\n  if (!AUTH_TOKEN) return false;\n  const dati = INDIRIZZO + Object.keys(p).sort().map((k) => k + p[k]).join('');\n  const attesa = crypto.createHmac('sha1', AUTH_TOKEN).update(Buffer.from(dati, 'utf8')).digest('base64');\n  const a = Buffer.from(attesa), b = Buffer.from(String(headers['x-twilio-signature'] || ''));\n  return a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nif (!firmaValida()) return out({ azione: 'rifiuta', codice: 403 });\nif (!String(p.From || '').startsWith('whatsapp:')) return out({ azione: 'ignora', codice: 200 });\n\nconst base = {\n  codice: 200,\n  sid: p.AccountSid,\n  a: p.From,\n  da: p.To,\n  nome: String(p.ProfileName || ''),\n  testo: String(p.Body || '').trim(),\n};\nconst media = Number(p.NumMedia || 0) > 0 ? { url: p.MediaUrl0, tipo: String(p.MediaContentType0 || '') } : null;\nconst vocale = media && media.tipo.startsWith('audio/') ? media : null;\n\nif (vocale && VOCALI_ATTIVI) {\n  return out({ ...base, azione: 'elabora', vocale: true, mediaUrl: vocale.url, mime: vocale.tipo,\n    avviso: '⏳ Ricevuto il vocale. Lo trascrivo e preparo la bozza del preventivo, ci vogliono circa 20 secondi.' });\n}\nif (base.testo.length >= 15) {\n  return out({ ...base, azione: 'elabora', vocale: false,\n    avviso: '⏳ Ricevuto. Preparo la bozza del preventivo, ci vogliono circa 15 secondi.' });\n}\nconst aiuto = vocale\n  ? 'I vocali non sono ancora attivi: scrivimi il sopralluogo come lo racconteresti a un collega e ti preparo la bozza.'\n  : 'Ciao' + (base.nome ? ' ' + base.nome.split(' ')[0] : '') + '! Sono PreventivoLampo. ' + (VOCALI_ATTIVI ? 'Mandami un vocale' : 'Scrivimi') + ' dopo il sopralluogo, come lo racconteresti a un collega (lavorazioni, misure, materiali), e ti preparo la bozza del preventivo da controllare dal telefono.';\nreturn out({ ...base, azione: 'aiuto', vocale: false, avviso: aiuto });"
      }
    },
