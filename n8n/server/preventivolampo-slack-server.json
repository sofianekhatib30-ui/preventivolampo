        "jsCode": "// Unisce la trascrizione al testo scritto nello stesso messaggio, se c'è.\nconst scritto = $('Verifica e smista').first().json.testo || '';\nconst trascritto = String($input.first().json.text || '').trim();\nreturn [{ json: { testo: [trascritto, scritto].filter(Boolean).join('\\n') } }];"
