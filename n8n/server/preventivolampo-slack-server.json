    {
      "id": "d9199a30-8914-49a3-bd5f-7859cece4227",
      "name": "Verifica e smista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Verifica che la richiesta venga davvero da Slack (firma HMAC sul corpo grezzo) e decide cosa fare.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nconst segreto = $env.SLACK_SIGNING_SECRET || '';\n\nlet grezzo = '';\ntry {\n  grezzo = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch (e) {\n  grezzo = '';\n}\nlet corpo = item.json.body;\nif ((!corpo || typeof corpo !== 'object' || !Object.keys(corpo).length) && grezzo) {\n  try { corpo = JSON.parse(grezzo); } catch (e) { corpo = {}; }\n}\ncorpo = corpo || {};\n\nfunction firmaValida() {\n  if (!segreto || !grezzo) return false;\n  const ts = String(headers['x-slack-request-timestamp'] || '');\n  const firma = String(headers['x-slack-signature'] || '');\n  if (!/^\\d+$/.test(ts) || Math.abs(Date.now() / 1000 - Number(ts)) > 300) return false;\n  const attesa = 'v0=' + crypto.createHmac('sha256', segreto).update(`v0:${ts}:${grezzo}`).digest('hex');\n  const a = Buffer.from(attesa), b = Buffer.from(firma);\n  return a.length === b.length && crypto.timingSafeEqual(a, b);\n}\n\nconst out = (o) => [{ json: o }];\n\n// Prima configurazione: Slack verifica l'indirizzo prima che il segreto sia sul server.\nif (corpo.type === 'url_verification' && (!segreto || firmaValida())) {\n  return out({ azione: 'sfida', challenge: corpo.challenge, codice: 200 });\n}\nif (!firmaValida()) return out({ azione: 'rifiuta', codice: 401 });\n// Slack ripete l'evento se non risponde in 3 secondi: la ripetizione si ignora, l'originale è già in lavoro.\nif (headers['x-slack-retry-num']) return out({ azione: 'ignora', codice: 200 });\nif (corpo.type !== 'event_callback' || !corpo.event) return out({ azione: 'ignora', codice: 200 });\n\nconst ev = corpo.event;\nif (ev.bot_id || ev.app_id) return out({ azione: 'ignora', codice: 200 });\nif (ev.subtype && ev.subtype !== 'file_share') return out({ azione: 'ignora', codice: 200 });\nconst privato = ev.type === 'message' && ev.channel_type === 'im';\nconst menzione = ev.type === 'app_mention';\nif (!privato && !menzione) return out({ azione: 'ignora', codice: 200 });\n\nconst testo = String(ev.text || '').replace(/<@[A-Z0-9]+>/g, '').trim();\nconst vocale = (ev.files || []).find(f => f.subtype === 'slack_audio' || /^audio\\//.test(f.mimetype || '') || (/^video\\//.test(f.mimetype || '') && f.subtype === 'slack_video'));\nconst base = {\n  codice: 200,\n  canale: ev.channel,\n  thread: ev.thread_ts || ev.ts,\n  utente: ev.user,\n  testo,\n};\nconst vocaliAttivi = Boolean($env.OPENAI_API_KEY);\n\nif (vocale && vocaliAttivi) {\n  return out({ ...base, azione: 'elabora', vocale: true, fileUrl: vocale.url_private_download || vocale.url_private, fileNome: vocale.name || 'vocale.m4a',\n    avviso: ':hourglass_flowing_sand: Ricevuto il vocale. Lo trascrivo e preparo la bozza, ci vogliono circa 20 secondi.' });\n}\nif (testo.length >= 15) {\n  return out({ ...base, azione: 'elabora', vocale: false,\n    avviso: ':hourglass_flowing_sand: Ricevuto. Preparo la bozza del preventivo, ci vogliono circa 15 secondi.' });\n}\nconst aiuto = vocale\n  ? 'I vocali non sono ancora attivi in questa demo. Scrivimi il sopralluogo come lo racconteresti a un collega e ti preparo la bozza.'\n  : 'Ciao! Raccontami il sopralluogo come lo diresti a un collega (lavorazioni, misure, materiali) e ti preparo la bozza del preventivo da controllare dal telefono.' + (vocaliAttivi ? ' Va bene anche una clip audio.' : '');\nreturn out({ ...base, azione: 'aiuto', vocale: false, avviso: aiuto });"
      }
    },
