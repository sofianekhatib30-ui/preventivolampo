# Copia in .env sul server (cp .env.example .env) e riempi. .env non va mai nel repository né in chat.

# Indirizzo di n8n (record A del dominio verso l'IP del server)
N8N_DOMINIO=n8n.kdigitalsolution.it
# Chiave che cifra le credenziali di n8n: generala una volta con  openssl rand -hex 32  e non cambiarla più
N8N_ENCRYPTION_KEY=

# App Slack (api.slack.com/apps → la tua app)
# Basic Information → Signing Secret
SLACK_SIGNING_SECRET=
# OAuth & Permissions → Bot User OAuth Token (inizia con xoxb-)
SLACK_BOT_TOKEN=

# PreventivoLampo
PL_BASE_URL=https://preventivolampo.vercel.app
# Stesso valore di ELABORA_SHARED_SECRET su Vercel
ELABORA_SHARED_SECRET=

# Vocali (facoltativo): senza chiave il bot accetta solo testo e lo dice
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
