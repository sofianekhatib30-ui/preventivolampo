    {
      "id": "a1a2c14d-2643-42cd-98b7-70f78c7d80ea",
      "name": "Verifica e smista",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// ⚙️ IMPOSTAZIONI (si compilano una volta, solo in n8n)\n// App Secret dell'app Meta: developers.facebook.com → la tua app → Impostazioni dell'app → Di base → Chiave segreta\nconst SEGRETO_APP = '';\n// Vocali: true se nel nodo «Trascrivi il vocale» c'è la credenziale del servizio di trascrizione\nconst VOCALI_ATTIVI = true;\nconst GRAPH = 'https://graph.facebook.com/v25.0';\nconst TRASCRIZIONE_URL = 'https://api.openai.com/v1/audio/transcriptions';\nconst TRASCRIZIONE_MODELLO = 'whisper-1';\n\n// Verifica che la richiesta venga davvero da Meta (firma HMAC sul corpo grezzo) e decide cosa fare.\nconst crypto = require('crypto');\nconst item = $input.first();\nconst headers = item.json.headers || {};\nlet grezzo = '';\ntry { grezzo = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8'); } catch (e) { grezzo = ''; }\nlet corpo = item.json.body;\nif ((!corpo || typeof corpo !== 'object' || !Object.keys(corpo).length) && grezzo) {\n  try { corpo = JSON.parse(grezzo); } catch (e) { corpo = {}; }\n}\ncorpo = corpo || {};\nconst out = (o) => [{ json: { GRAPH, TRASCRIZIONE_URL, TRASCRIZIONE_MODELLO, ...o } }];\n\nfunction firmaValida() {\n  if (!SEGRETO_APP || !grezzo) return false;\n  const firma = String(headers['x-hub-signature-256'] || '');\n  const attesa = 'sha256=' + crypto.createHmac('sha256', SEGRETO_APP).update(grezzo).digest('hex');\n  const a = Buffer.from(attesa), b = Buffer.from(firma);\n  return a.length === b.length && crypto.timingSafeEqual(a, b);\n}\nif (!firmaValida()) return out({ azione: 'rifiuta', codice: 401 });\nif (corpo.object !== 'whatsapp_business_account') return out({ azione: 'ignora', codice: 200 });\n\nconst value = corpo.entry?.[0]?.changes?.[0]?.value || {};\nconst msg = (value.messages || [])[0];\n// Le notifiche di stato (inviato, consegnato, letto) delle nostre risposte non richiedono nulla.\nif (!msg) return out({ azione: 'ignora', codice: 200 });\n// Meta può ripetere un evento: un messaggio più vecchio di 10 minuti non si rielabora.\nif (Math.abs(Date.now() / 1000 - Number(msg.timestamp || 0)) > 600) return out({ azione: 'ignora', codice: 200 });\n\nconst base = {\n  codice: 200,\n  numeroId: value.metadata?.phone_number_id,\n  a: msg.from,\n  messaggioId: msg.id,\n  nome: value.contacts?.[0]?.profile?.name || '',\n  testo: msg.type === 'text' ? String(msg.text?.body || '').trim() : '',\n};\nconst vocale = msg.type === 'audio' ? msg.audio : null;\n\nif (vocale && VOCALI_ATTIVI) {\n  return out({ ...base, azione: 'elabora', vocale: true, mediaId: vocale.id, mime: vocale.mime_type || 'audio/ogg',\n    avviso: '⏳ Ricevuto il vocale. Lo trascrivo e preparo la bozza del preventivo, ci vogliono circa 20 secondi.' });\n}\nif (base.testo.length >= 15) {\n  return out({ ...base, azione: 'elabora', vocale: false,\n    avviso: '⏳ Ricevuto. Preparo la bozza del preventivo, ci vogliono circa 15 secondi.' });\n}\nconst aiuto = vocale\n  ? 'I vocali non sono ancora attivi in questa demo: scrivimi il sopralluogo come lo racconteresti a un collega e ti preparo la bozza.'\n  : 'Ciao' + (base.nome ? ' ' + base.nome.split(' ')[0] : '') + '! Sono PreventivoLampo. ' + (VOCALI_ATTIVI ? 'Mandami un vocale' : 'Scrivimi') + ' dopo il sopralluogo, come lo racconteresti a un collega (lavorazioni, misure, materiali), e ti preparo la bozza del preventivo da controllare dal telefono.';\nreturn out({ ...base, azione: 'aiuto', vocale: false, avviso: aiuto });"
      }
    },
