    {
      "id": "27c74904-2864-49fb-b74b-937ee5ceac48",
      "name": "Controlla token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Meta verifica l'indirizzo una volta con una GET: risponde la sfida solo se il token coincide.\n// ⚙️ Token di verifica: lo stesso che scrivi in Meta → WhatsApp → Configurazione → Webhook → «Token di verifica».\nconst TOKEN_VERIFICA = '';\nconst q = $input.first().json.query || {};\nconst ok = TOKEN_VERIFICA && q['hub.mode'] === 'subscribe' && q['hub.verify_token'] === TOKEN_VERIFICA;\nreturn [{ json: { codice: ok ? 200 : 403, corpo: ok ? String(q['hub.challenge'] || '') : 'no' } }];"
      }
    },
    {
      "id": "28e11616-0c35-4523-97cf-934e71b61db9",
      "name": "Rispondi a Meta (sfida)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.corpo }}",
        "options": {
          "responseCode": "={{ $json.codice }}"
        }
      }
    },
    {
      "id": "1baae25f-e7d1-4458-96cb-d604be26f45c",
      "name": "WhatsApp: messaggio in arrivo",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "8912832c-5278-4c43-a809-f185a2e4c340",
      "parameters": {
