# Copia in .env.local e riempi i valori. .env.local non entra mai nel repository.

# Motore: estrazione e abbinamento
ANTHROPIC_API_KEY=

# Demo online
# La pagina /prova e /api/elabora sono attive in sviluppo; in produzione solo con PROVA_ATTIVA=1
PROVA_ATTIVA=
# Se impostato, /prova chiede questo codice prima di chiamare Claude
PROVA_CODICE=
# Archivio dei preventivi: con un Blob store collegato (BLOB_READ_WRITE_TOKEN) gli oggetti sono privati su Vercel Blob;
# senza, file JSON in PREVENTIVI_DIR (vuoto = archivio-locale/preventivi)
BLOB_READ_WRITE_TOKEN=
PREVENTIVI_DIR=

# Pulizia notturna (/api/pulizia, cron di Vercel): se impostato, la route pretende Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Ingresso dall'automazione (n8n): segreto condiviso nell'header x-elabora-secret
ELABORA_SHARED_SECRET=

# Area imprese (/accedi, /area): progetto Supabase con le tabelle pl_* (supabase/migrations/)
# URL e chiave pubblicabile non sono segreti; la chiave di servizio sì: solo sul server, mai nel browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Facoltativo: chiave per firmare il cookie di sessione (vuoto = derivata dalla chiave di servizio)
SESSIONE_SEGRETO=

# Home
# URL pubblico del sito, per sitemap e immagine Open Graph (vuoto = http://localhost:3000)
SITO_URL=
# 1 = home di vendita con modulo di candidatura; vuoto = demo pubblica con banner
CANDIDATURE_APERTE=
# Cartella delle candidature salvate su file in sviluppo (vuoto = archivio-locale/candidature)
CANDIDATURE_DIR=

# Da collegare: trascrizione degli audio (F4)
TRANSCRIPTION_PROVIDER=
TRANSCRIPTION_API_KEY=
